#!/usr/bin/env bash

set -euo pipefail

VERSION="1.2.0"
# Best available quality; capped dynamically by screen height and connection speed.
DEFAULT_FORMAT='bestvideo+bestaudio/best'
RESULT_COUNT=20
# Window size as a percentage of the screen; mpv preserves the video's aspect ratio.
AUTOFIT="${BASHYT_AUTOFIT:-90%x90%}"
# Clients that don't require a PO token. yt-dlp merges formats from all of them.
YT_CLIENTS="${BASHYT_CLIENTS:-tv,tv_simply,web_safari,android_vr}"

show_help() {
  cat <<EOF
bashyt - A lightweight YouTube search and player for the terminal.

Usage:
    bashyt [SEARCH TERMS]
    bashyt [OPTION]

Options:
    -h, --help       Show this help message
    -v, --version    Show version information

Examples:
    bashyt
    bashyt "raj shamani neurologist"
    bashyt linux terminal tutorials

Dependencies:
    yt-dlp
    fzf
    mpv
EOF
}

show_version() {
  printf 'bashyt %s\n' "$VERSION"
}

# Height of the tallest connected display, or empty if it can't be detected.
# xrandr/xdpyinfo cover X11 and most XWayland sessions; bare Wayland may fail.
screen_height() {
  local height=""
  if command -v xrandr >/dev/null 2>&1; then
    height=$(xrandr --current 2>/dev/null | awk '
      /\*/ { split($1, part, "x"); if (part[2] + 0 > max) max = part[2] + 0 }
      END { if (max) print max }')
  fi
  if [[ -z "$height" ]] && command -v xdpyinfo >/dev/null 2>&1; then
    height=$(xdpyinfo 2>/dev/null | awk '
      /dimensions:/ { split($2, part, "x"); print part[2] + 0; exit }')
  fi
  printf '%s' "$height"
}

# Download speed in bytes/sec via a short probe, or empty on failure.
connection_speed() {
  command -v curl >/dev/null 2>&1 || return 1
  local speed
  speed=$(curl -o /dev/null -sS -L --max-time 8 -w '%{speed_download}' \
    'https://speed.cloudflare.com/__down?bytes=5000000' 2>/dev/null) || return 1
  [[ "$speed" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  printf '%s' "${speed%%.*}"
}

# Highest video height the connection can sustain comfortably.
speed_height_cap() {
  local speed=$1 cap
  if ((speed >= 3000000)); then cap=4320   # ~24 Mbps
  elif ((speed >= 1250000)); then cap=2160 # ~10 Mbps
  elif ((speed >= 750000)); then cap=1440  # ~6 Mbps
  elif ((speed >= 375000)); then cap=1080  # ~3 Mbps
  elif ((speed >= 190000)); then cap=720   # ~1.5 Mbps
  else cap=480
  fi
  printf '%s' "$cap"
}

# yt-dlp format string: best quality, capped by screen height and connection speed.
choose_format() {
  if [[ -n "${BASHYT_FORMAT:-}" ]]; then
    printf '%s' "$BASHYT_FORMAT"
    return
  fi
  local screen cap speed max=""
  screen=$(screen_height)
  speed=$(connection_speed || true)
  if [[ -n "$speed" ]]; then
    cap=$(speed_height_cap "$speed")
  fi
  if [[ -n "$screen" && -n "$cap" ]]; then
    if ((screen <= cap)); then max=$screen; else max=$cap; fi
  elif [[ -n "$screen" ]]; then
    max=$screen
  elif [[ -n "$cap" ]]; then
    max=$cap
  fi
  if [[ -n "$max" ]]; then
    printf 'bestvideo[height<=%d]+bestaudio/best[height<=%d]/best' "$max" "$max"
  else
    printf '%s' "$DEFAULT_FORMAT"
  fi
}

check_dependency() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf "Error: '%s' is required but was not found in PATH.\n" "$1" >&2
    exit 1
  fi
}

for dependency in yt-dlp fzf mpv; do
  check_dependency "$dependency"
done

case "${1:-}" in
-h | --help)
  show_help
  exit 0
  ;;
-v | --version)
  show_version
  exit 0
  ;;
esac

if [[ $# -eq 0 ]]; then
  read -r -p "Search YouTube: " QUERY
else
  QUERY="$*"
fi

if [[ -z "$QUERY" ]]; then
  printf 'Error: no search query provided.\n' >&2
  exit 1
fi

RESULT=$(
  yt-dlp \
    --flat-playlist \
    --print '%(id)s	%(title)s	%(channel)s	%(duration_string)s' \
    "ytsearch${RESULT_COUNT}:${QUERY}" |
    fzf \
      --delimiter=$'\t' \
      --with-nth=2,3,4 \
      --layout=reverse \
      --height=80% \
      --border \
      --prompt="Select video > "
)

if [[ -z "$RESULT" ]]; then
  exit 0
fi

VIDEO_ID=$(printf '%s' "$RESULT" | cut -f1)

if [[ -z "$VIDEO_ID" ]]; then
  printf 'Error: could not determine video ID.\n' >&2
  exit 1
fi

URL="https://www.youtube.com/watch?v=${VIDEO_ID}"

EXTRACTOR_ARGS="youtube:player_client=${YT_CLIENTS}"

FORMAT=$(choose_format)

exec mpv \
  --autofit="$AUTOFIT" \
  --ytdl-format="$FORMAT" \
  --ytdl-raw-options="extractor-args=%${#EXTRACTOR_ARGS}%${EXTRACTOR_ARGS}" \
  "$URL"
