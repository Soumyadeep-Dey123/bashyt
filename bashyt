#!/usr/bin/env bash

set -euo pipefail

VERSION="1.0.0"
FORMAT='bestvideo[vcodec^=vp9][height<=1080]+bestaudio/best'
RESULT_COUNT=20

show_help() {
    cat <<EOF
bashyt - A lightweight YouTube search and player for the terminal.

Usage:
    bashyt [SEARCH TERMS]
    bashyt [OPTION]

Options:
    -h, --help       Show this help message
    -v, --version    Show version information

Examples:
    bashyt
    bashyt "raj shamani neurologist"
    bashyt linux terminal tutorials

Dependencies:
    yt-dlp
    fzf
    mpv
EOF
}

show_version() {
    printf 'bashyt %s\n' "$VERSION"
}

check_dependency() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf "Error: '%s' is required but was not found in PATH.\n" "$1" >&2
        exit 1
    fi
}

for dependency in yt-dlp fzf mpv; do
    check_dependency "$dependency"
done

case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        show_version
        exit 0
        ;;
esac

if [[ $# -eq 0 ]]; then
    read -r -p "Search YouTube: " QUERY
else
    QUERY="$*"
fi

if [[ -z "$QUERY" ]]; then
    printf 'Error: no search query provided.\n' >&2
    exit 1
fi

RESULT=$(
    yt-dlp \
        --flat-playlist \
        --print '%(id)s	%(title)s	%(channel)s	%(duration_string)s' \
        "ytsearch${RESULT_COUNT}:${QUERY}" |
    fzf \
        --delimiter=$'\t' \
        --with-nth=2,3,4 \
        --layout=reverse \
        --height=80% \
        --border \
        --prompt="Select video > "
)

if [[ -z "$RESULT" ]]; then
    exit 0
fi

VIDEO_ID=$(printf '%s' "$RESULT" | cut -f1)

if [[ -z "$VIDEO_ID" ]]; then
    printf 'Error: could not determine video ID.\n' >&2
    exit 1
fi

URL="https://www.youtube.com/watch?v=${VIDEO_ID}"

exec mpv \
    --ytdl-format="$FORMAT" \
    "$URL"
